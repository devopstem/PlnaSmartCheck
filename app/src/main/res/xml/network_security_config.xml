<?xml version="1.0" encoding="utf-8"?>
<!-- Запрет cleartext HTTP: только HTTPS (OCR-модели и Firebase). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
